<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <!-- Datos/: datos de ejecución (caché de diagramas de SPs, etc.). No se compilan ni se publican. -->
  <ItemGroup>
    <Compile Remove="Datos\**" />
    <Content Remove="Datos\**" />
    <None Remove="Datos\**" />
  </ItemGroup>

</Project>
